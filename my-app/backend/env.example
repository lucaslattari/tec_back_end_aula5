# Aula 5 - Tecnologias Back-End
# Copie este arquivo para .env e preencha os valores conforme seu ambiente.
# Nunca coloque senhas reais ou segredos de producao neste exemplo.

# PostgreSQL (confira usuario, senha, banco e porta no docker-compose.yml)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO?schema=public"

# Chave de assinatura dos tokens JWT
# Substitua por uma sequencia aleatoria longa e exclusiva no .env local.
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE"

# Porta local do servidor Express
PORT=3001

# Origem do front-end (React/Vite) para a configuracao de CORS.
# Confira no server.ts se a variavel utilizada se chama FRONTEND_URL.
FRONTEND_URL="http://localhost:5173"
